# TG Bot Token
TOKEN=your_telegram_bot_token

# TG User ID (comma separated for multiple)
ADMIN_IDS=123456789

# PikPak accounts (comma separated)
PIKPAK_USER=user1@example.com,user2@example.com

# PikPak passwords (comma separated, same order as accounts)
PIKPAK_PASSWORD=password1,password2

# Aria2 config
ARIA2_HTTPS=false
ARIA2_HOST=your.aria2.host
ARIA2_PORT=6800
ARIA2_SECRET=your_aria2_secret
ARIA2_DOWNLOAD_PATH=/downloads

# Optional config
# TG_API_URL=https://api.telegram.org
# PIKPAK_OFFLINE_PATH=/My Pack
# AUTO_DELETE={"user1@example.com": "True"}